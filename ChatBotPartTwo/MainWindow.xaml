<Window x:Class="ChatBotPartTwo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChatBotPartTwo"
        mc:Ignorable="d"
        Title="CyberBot" Height="450" Width="800"
        Background="#0F3460">
    <Grid>

        <!-- ================= MAIN LAYOUT ================= -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Grid Grid.Column="0" Background="#1A1A2E">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="CyberBot"
                           Foreground="#00D2FF"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,40"/>

                <Button Content="Home"
                        Height="40"
                        Width="120"
                        Margin="0,8"
                        Click="Navigate_home"
                        Background="#4A90E2"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>

                <Button Content="Chats"
                        Height="40"
                        Width="120"
                        Margin="0,8"
                        Click="navigate_chats"
                        Background="#4A90E2"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>

                <Button Content="Add Task"
                        Height="40"
                        Width="120"
                        Margin="0,8"
                        Click="Navigate_task"
                        Background="#4A90E2"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>

                <Button Content="Play Quiz"
                        Height="40"
                        Width="120"
                        Margin="0,8"
                        Click="navigate_quiz"
                        Background="#4A90E2"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>

                <Button Content="Activity Log"
                        Height="40"
                        Width="120"
                        Margin="0,8"
                        Click="navigate_activityLog"
                        Background="#4A90E2"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>

                <Button Content="Exit"
                        Height="40"
                        Width="120"
                        Margin="0,8"
                        Click="Exit_app"
                        Background="#E74C3C"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- ================= HOME PAGE ================= -->
        <Grid x:Name="home_page"
              Grid.Column="1"
              Visibility="Visible">
            <Grid.Background>
                <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                    <GradientStop Color="#16213E" Offset="0"/>
                    <GradientStop Color="#0F3460" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Image Source="OurLogo.png"
                       Height="200"
                       Width="350"
                       Margin="0,0,0,20"/>

                <TextBlock Text="Cyber Security Awareness Bot"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#00D2FF"
                           TextAlignment="Center"/>

                <TextBlock Text="Learn about online safety, phishing attacks, password protection, and more."
                           FontSize="16"
                           Width="600"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,15,0,0"
                           Foreground="#B0BEC5"/>
            </StackPanel>
        </Grid>

        <!-- ================= CHATS PAGE ================= -->
        <Grid x:Name="chats_page"
              Grid.Column="1"
              Visibility="Collapsed">
            <Grid.Background>
                <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                    <GradientStop Color="#16213E" Offset="0"/>
                    <GradientStop Color="#0F3460" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Chat Area -->
            <Border Margin="15"
                    Background="#1A1A2E"
                    CornerRadius="12"
                    Padding="10"
                    BorderBrush="#4A90E2"
                    BorderThickness="1">
                <ListBox x:Name="ChatList"
                         BorderThickness="0"
                         FontSize="14"
                         Background="Transparent"
                         Foreground="#E0E0E0"/>
            </Border>

            <!-- Input Area -->
            <Border Grid.Row="1"
                    Margin="15"
                    Background="#1A1A2E"
                    CornerRadius="12"
                    Padding="10"
                    BorderBrush="#4A90E2"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="UserInput"
                             Width="450"
                             Height="40"
                             FontSize="14"
                             Padding="10"
                             Background="#2D2D44"
                             Foreground="#E0E0E0"
                             BorderThickness="0"
                             CaretBrush="#00D2FF"/>
                    <Button Content="Send"
                            Width="150"
                            Height="40"
                            Margin="10,0,0,0"
                            Click="HandleUserInput"
                            Background="#00B894"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= ADD TASK PAGE ================= -->
        <Grid x:Name="addTask_page"
      Grid.Column="1"
      Visibility="Collapsed">
            <Grid.Background>
                <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                    <GradientStop Color="#16213E" Offset="0"/>
                    <GradientStop Color="#0F3460" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title -->
            <TextBlock Text="Add Tasks"
               Grid.Row="0"
               Grid.ColumnSpan="2"
               FontSize="18"
               FontWeight="Bold"
               Foreground="#00D2FF"
               Margin="20,15,0,0"/>

            <!-- Tip -->
            <TextBlock Text="Tip: Type 'add task update antivirus' or 'remind me in 3 days'"
               Grid.Row="1"
               Grid.ColumnSpan="2"
               FontSize="13"
               Foreground="#B0BEC5"
               Margin="20,5,0,5"/>

            <!-- Input TextBox -->
            <TextBox x:Name="user_question"
             Grid.Row="2"
             Grid.Column="0"
             Height="35"
             Margin="20,0,10,5"
             Background="#2D2D44"
             Foreground="#E0E0E0"
             BorderThickness="0"
             Padding="10"
             FontSize="14"
             CaretBrush="#00D2FF"/>

            <!-- Submit Button -->
            <Button Content="Submit"
            Grid.Row="2"
            Grid.Column="1"
            Width="120"
            Height="35"
            Margin="0,0,20,5"
            Click="AddTask_Click"
            Background="#4A90E2"
            Foreground="White"
            BorderThickness="0"
            Cursor="Hand"
            FontWeight="SemiBold"/>

            <!-- Task List -->
            <Border Grid.Row="3"
            Grid.ColumnSpan="2"
            Margin="20,5,20,20"
            Background="#1A1A2E"
            CornerRadius="12"
            Padding="10"
            BorderBrush="#4A90E2"
            BorderThickness="1">
                <ListBox x:Name="show_chats"
                 BorderThickness="0"
                 Background="Transparent"
                 Foreground="#E0E0E0"
                 FontSize="14"
                 MouseDoubleClick="show_chats_MouseDoubleClick"/>
            </Border>
        </Grid>

        <!-- ================= QUIZ PAGE ================= -->
        <Grid x:Name="quiz_page"
              Grid.Column="1"
              Visibility="Collapsed">
            <Grid.Background>
                <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                    <GradientStop Color="#16213E" Offset="0"/>
                    <GradientStop Color="#0F3460" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Width="500">
                <TextBlock Text="Cybersecurity Quiz"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#00D2FF"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Question"
                           x:Name="DisplayedQuestion"
                           FontSize="18"
                           Foreground="#E0E0E0"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <Button x:Name="FirstChoiceButton"
                        Click="HandleAnswerSelection"
                        Padding="15"
                        Margin="0,5"
                        Background="#2D2D44"
                        Foreground="#E0E0E0"
                        BorderThickness="1"
                        BorderBrush="#4A90E2"
                        Cursor="Hand"
                        FontSize="14"/>

                <Button x:Name="SecondChoiceButton"
                        Click="HandleAnswerSelection"
                        Padding="15"
                        Margin="0,5"
                        Background="#2D2D44"
                        Foreground="#E0E0E0"
                        BorderThickness="1"
                        BorderBrush="#4A90E2"
                        Cursor="Hand"
                        FontSize="14"/>

                <Button x:Name="ThirdChoiceButton"
                        Click="HandleAnswerSelection"
                        Padding="15"
                        Margin="0,5"
                        Background="#2D2D44"
                        Foreground="#E0E0E0"
                        BorderThickness="1"
                        BorderBrush="#4A90E2"
                        Cursor="Hand"
                        FontSize="14"/>

                <Button x:Name="FourthChoiceButton"
                        Click="HandleAnswerSelection"
                        Padding="15"
                        Margin="0,5"
                        Background="#2D2D44"
                        Foreground="#E0E0E0"
                        BorderThickness="1"
                        BorderBrush="#4A90E2"
                        Cursor="Hand"
                        FontSize="14"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,0">
                    <Button x:Name="NextQuestionButton"
                            Content="Next"
                            Click="HandleNextQuestion"
                            Padding="20,10"
                            Background="#00B894"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            FontSize="14"/>

                    <TextBlock x:Name="DisplayScore"
                               Text="Score: 0"
                               FontSize="16"
                               Foreground="#00D2FF"
                               VerticalAlignment="Center"
                               Margin="20,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ================= ACTIVITY LOG PAGE ================= -->
        <Grid x:Name="activitylog_page"
      Grid.Column="1"
      Visibility="Collapsed">
            <Grid.Background>
                <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                    <GradientStop Color="#16213E" Offset="0"/>
                    <GradientStop Color="#0F3460" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title -->
            <TextBlock Text="Activity Log"
               Grid.Row="0"
               Grid.ColumnSpan="2"
               FontSize="22"
               FontWeight="Bold"
               Foreground="#00D2FF"
               Margin="20,15,0,0"/>

            <!-- Subtitle -->
            <TextBlock Text="Type 'show activity log' to view recent activity"
               Grid.Row="1"
               Grid.ColumnSpan="2"
               FontSize="13"
               Foreground="#B0BEC5"
               Margin="20,5,0,5"/>

            <!-- Input TextBox -->
            <TextBox x:Name="activityInput"
             Grid.Row="2"
             Grid.Column="0"
             Height="35"
             Margin="20,0,10,5"
             Background="#2D2D44"
             Foreground="#E0E0E0"
             BorderThickness="0"
             Padding="10"
             FontSize="14"
             CaretBrush="#00D2FF"/>

            <!-- Check Button -->
            <Button Content="Check"
            Grid.Row="2"
            Grid.Column="1"
            Width="120"
            Height="35"
            Margin="0,0,20,5"
            Click="ViewActivityLog_Click"
            Background="#4A90E2"
            Foreground="White"
            BorderThickness="0"
            Cursor="Hand"
            FontWeight="SemiBold"/>

            <!-- Activity List -->
            <Border Grid.Row="3"
            Grid.ColumnSpan="2"
            Margin="20,5,20,20"
            Background="#1A1A2E"
            CornerRadius="12"
            Padding="10"
            BorderBrush="#4A90E2"
            BorderThickness="1">
                <ListView x:Name="activityList"
                  Background="Transparent"
                  Foreground="#E0E0E0"
                  FontSize="14"
                  BorderThickness="0"/>
            </Border>
        </Grid>
        <!-- ================= EXIT PAGE ================= -->
        <Grid x:Name="exit_page"
              Grid.Column="1"
              Visibility="Collapsed">
            <Grid.Background>
                <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                    <GradientStop Color="#16213E" Offset="0"/>
                    <GradientStop Color="#0F3460" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="Thank you for using CyberBot"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#00D2FF"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Stay safe online!"
                           FontSize="18"
                           Foreground="#B0BEC5"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>

    </Grid>
</Window>